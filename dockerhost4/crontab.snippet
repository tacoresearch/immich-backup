# Add with: sudo crontab -e  (root's crontab, since docker exec + the
# /root/.ssh key both need root)

# Nightly backup at 2am. Path assumes the repo was cloned to /opt/immich-backup
# (see README.md) -- adjust if you cloned it somewhere else.
0 2 * * * /opt/immich-backup/dockerhost4/backup-immich.sh >> /var/log/immich-backup.log 2>&1
